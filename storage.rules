rules_version = '2';

/*
 * Attachments, event documents and event logos.
 *
 * Storage rules see the same custom claims as Firestore rules, so per-event
 * admin is enforced identically here. The client-side checks in
 * src/lib/firebase/storage.ts are for feedback only — anyone can call the
 * Storage API directly, so type and size limits have to hold here too.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    function manages(eventId) {
      return isSuperAdmin() || (
        request.auth != null &&
        request.auth.token.events is list &&
        eventId in request.auth.token.events
      );
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    function withinSizeLimit() {
      return request.resource.size < 15 * 1024 * 1024;
    }

    /*
     * Event-owned files: documents and branding.
     * Public read — a spectator downloading a bulletin is never signed in.
     *
     * `folder != 'entries'` is load-bearing, not tidiness. Storage rules OR
     * together: without it, a signature at events/X/entries/sig.png would match
     * this rule as well as the restricted one below, and `allow read: if true`
     * would win. Excluding the folder here is what keeps that data private.
     */
    match /events/{eventId}/{folder}/{fileName} {
      allow read: if folder != 'entries';

      /*
       * Split for the reason the entries block below spells out: `write`
       * includes delete, and on a delete request.resource is null, so
       * isAllowedType() throws and the delete is refused -- for admins too.
       * Replacing an event logo or removing a document left the old object
       * in the bucket, unreferenced and unreachable.
       */
      allow create, update: if manages(eventId)
        && folder != 'entries'
        && isAllowedType()
        && withinSizeLimit();

      allow delete: if manages(eventId) && folder != 'entries';
    }

    /*
     * Signatures and generated entry PDFs. NOT public, unlike everything else
     * under events/ -- a signature image is as sensitive as the form it signs.
     * Read is limited to that event's admins; the filler's own copy is served
     * through the app from a URL only they receive.
     */
    match /events/{eventId}/entries/{allPaths=**} {
      allow read: if manages(eventId);

      /*
       * create and update, not write. `write` also covers delete, and on a
       * delete `request.resource` is null -- so isAllowedType() fails and the
       * delete is refused, including for admins. Splitting them is what lets an
       * organiser actually remove an entry's files.
       */
      allow create, update: if request.auth != null
        && isAllowedType()
        && withinSizeLimit();

      allow delete: if manages(eventId);
    }

    /*
     * App sponsor logos. Outside events/ because the sponsor is not tied to
     * one, so the event-scoped rule above cannot cover them. Public to read
     * like every other logo; only a super admin may put one here.
     */
    match /sponsors/{fileName} {
      allow read: if true;

      /*
       * create and update, not write -- the same split the entries block
       * makes, for the same reason. `write` also covers delete, and on a
       * delete request.resource is null, so isAllowedType() fails and the
       * delete is refused. Replacing a sponsor's logo would leave the old
       * file behind forever.
       */
      allow create, update: if isSuperAdmin() && isAllowedType() && withinSizeLimit();
      allow delete: if isSuperAdmin();
    }

    // Notice attachments, written before an event scoping existed on this path.
    // Any event admin may write here; tightening it would break existing links.
    match /notices/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isAllowedType() && withinSizeLimit();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
