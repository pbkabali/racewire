rules_version = '2';

/*
 * Attachments, event documents and event logos.
 *
 * Storage rules see the same custom claims as Firestore rules, so per-event
 * admin is enforced identically here. The client-side checks in
 * src/lib/firebase/storage.ts are for feedback only — anyone can call the
 * Storage API directly, so type and size limits have to hold here too.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    function manages(eventId) {
      return isSuperAdmin() || (
        request.auth != null &&
        request.auth.token.events is list &&
        eventId in request.auth.token.events
      );
    }

    function isAllowedType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    function withinSizeLimit() {
      return request.resource.size < 15 * 1024 * 1024;
    }

    // Event-owned files: documents and branding.
    // Public read — a spectator downloading a bulletin is never signed in.
    match /events/{eventId}/{folder}/{fileName} {
      allow read: if true;
      allow write: if manages(eventId) && isAllowedType() && withinSizeLimit();
    }

    // Notice attachments, written before an event scoping existed on this path.
    // Any event admin may write here; tightening it would break existing links.
    match /notices/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isAllowedType() && withinSizeLimit();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
