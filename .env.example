# Firebase web app config.
# Copy this file to .env.local and fill in real values:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
# These are not secrets (they ship in the client bundle); Firestore rules are
# what actually protect your data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push key: Project settings -> Cloud Messaging -> Web Push certificates.
# Leave blank to disable in-browser notifications.
VITE_FIREBASE_VAPID_KEY=

# Set to true to point the app at local emulators (firebase emulators:start).
VITE_USE_FIREBASE_EMULATORS=false
