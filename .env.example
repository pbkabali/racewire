# Firebase web app config.
#
#   cp .env.example .env.local     then fill in the values below
#
# Where to find them:
#   Firebase console -> gear -> Project settings -> General
#     -> Your apps -> Web app -> SDK setup and configuration -> Config
#
# The console gives you a JS object with camelCase keys. They map onto the
# names below one-to-one -- apiKey -> VITE_FIREBASE_API_KEY, and so on.
# Step 3 of docs/firebase-setup.md has the full mapping table.
#
# Format: no quotes, no spaces around "=", no trailing commas.
#
# These are NOT secrets -- they ship in the client bundle. Firestore and
# Storage rules are what actually protect your data. Still, .env.local is
# gitignored: keep staging and production values apart.

# apiKey
VITE_FIREBASE_API_KEY=
# authDomain            e.g. your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
# projectId
VITE_FIREBASE_PROJECT_ID=
# storageBucket         e.g. your-project.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=
# messagingSenderId     the numeric project number
VITE_FIREBASE_MESSAGING_SENDER_ID=
# appId                 e.g. 1:123456789:web:abc123
VITE_FIREBASE_APP_ID=

# Web push key, from a different tab:
#   Project settings -> Cloud Messaging -> Web Push certificates
#     -> Generate key pair
# Optional. Blank simply disables in-browser notifications; SMS and WhatsApp
# are unaffected.
VITE_FIREBASE_VAPID_KEY=

# Point the app at local emulators instead of live Firebase.
VITE_USE_FIREBASE_EMULATORS=false
