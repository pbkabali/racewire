{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    /* WebWorker instead of DOM: the service worker global scope is a different
       environment, and the two libs conflict if combined. */
    "lib": ["ES2023", "WebWorker"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/info"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/sw.ts", "src/lib/firebase/config.ts"]
}
