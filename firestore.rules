rules_version = '2';

/*
 * Public board, restricted publishing.
 *
 * Admin rights live in custom claims, not documents: claims arrive inside the
 * ID token, so these checks cost no reads and cannot be edited by the client.
 * Set them with functions/scripts/grant-admin.mjs.
 *
 * Claim shape:
 *   { superAdmin: true }                  -> every event
 *   { admin: true, events: ['KRC26'] }    -> only those events
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }

    /*
     * `events` may be absent or a non-list on a malformed claim, so the type is
     * checked before `in` — a rules error would deny, but silently and with a
     * far less obvious cause than an explicit guard.
     */
    function manages(eventId) {
      return isSuperAdmin() || (
        request.auth != null &&
        request.auth.token.events is list &&
        eventId in request.auth.token.events
      );
    }

    // Events themselves: world-readable so the picker works signed-out.
    // Only super admins may create or delete an event namespace; an event
    // admin may edit their own event's details but not spawn new ones.
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if manages(eventId);

      // Everything an event owns. Readable by anyone, writable by its admins.
      // Scoping by path is the point of subcollections: there is no way for a
      // query here to return another event's documents.
      match /notices/{noticeId} {
        allow read: if true;
        allow write: if manages(eventId);
      }

      match /races/{raceId} {
        allow read: if true;
        allow write: if manages(eventId);
      }

      match /documents/{documentId} {
        allow read: if true;
        allow write: if manages(eventId);
      }

      match /folders/{folderId} {
        allow read: if true;
        allow write: if manages(eventId);
      }

      /*
       * Competition licences. A competitor must be able to check their own
       * number at the entry gate, but the list as a whole is personal data:
       * names attached to licence numbers.
       *
       * `get` allows reading one document by id; `list` is what a query needs.
       * Allowing get and denying list means a filler can verify the number they
       * already hold and cannot enumerate anybody else's.
       */
      match /licences/{licenceNumber} {
        allow get: if true;
        allow list: if manages(eventId);
        allow write: if manages(eventId);

        /*
         * The holder's personal details from the championship registration
         * list (date of birth, phone, email), used to prefill the entry form.
         *
         * The licence document above is world-readable by id so the gate
         * works signed-out; these fields must not be. Requiring a signed-in
         * reader means, in practice, someone who has passed the phone OTP —
         * a rate-limited, identity-attached path to any single record, and
         * still no path at all to the list.
         */
        match /details/{detailsId} {
          allow get: if request.auth != null;
          allow list: if manages(eventId);
          allow write: if manages(eventId);
        }
      }

      /*
       * Filled entry forms — the most sensitive data in the app: dates of
       * birth, passport nationality, addresses, next of kin, signatures.
       *
       * Never public, and never readable across events. A filler may read and
       * write only their own, and only while it is still a draft; once
       * submitted it is the organiser's record and the filler cannot alter it.
       */
      match /entries/{entryId} {
        /*
         * `resource == null` is load-bearing. On a get for a document that does
         * not exist, resource is null, so resource.data.uid throws and the rule
         * denies -- meaning a first-time filler is refused the very read that
         * tells the app they have nothing yet. Reading a missing document
         * returns nothing, so allowing it discloses nothing.
         */
        allow get: if manages(eventId) || (
          request.auth != null && (
            resource == null || resource.data.uid == request.auth.uid
          )
        );

        // Listing is the whole collection of personal data; admins only. A
        // filler reaches their own entry by id, never by query.
        allow list: if manages(eventId);

        allow create: if request.auth != null &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'draft';

        allow update: if manages(eventId) || (
          request.auth != null &&
          resource.data.uid == request.auth.uid &&
          resource.data.status == 'draft' &&
          request.resource.data.uid == resource.data.uid
        );

        allow delete: if manages(eventId);
      }
    }

    /*
     * Push tokens. A device may register and update its own token, but nobody
     * may list them — the collection is a mailing list, and readable would
     * hand it to anyone. Cloud Functions bypass rules entirely, so fan-out
     * still works.
     */
    match /subscribers/{token} {
      allow read: if false;
      allow create, update: if request.auth != null || true;
      allow delete: if false;
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it deliberately, rather than inheriting access by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
